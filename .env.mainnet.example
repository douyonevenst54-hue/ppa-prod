# Mainnet environment for Pap Pad App.
#
# Copy to .env.mainnet, fill in, and set the same values in the Vercel project
# that serves Mainnet. Nothing here is shared with the Testnet deployment:
# a testnet API key in a mainnet app makes payments fail, and a shared database
# would carry testnet balances into real play.
#
#   cp .env.mainnet.example .env.mainnet
#   npx tsx --env-file=.env.mainnet scripts/bootstrap-mainnet.ts
#
# Never commit the filled-in file. .env* is gitignored except this example.

# ── The network switch ────────────────────────────────────────────────────
# Flips the app to Mainnet and removes the TEST-PI badge from the balance.
NEXT_PUBLIC_PI_NETWORK=mainnet

# Leave unset or false on Mainnet. Sandbox is a testnet convenience.
NEXT_PUBLIC_PI_SANDBOX=false

# ── Pi ────────────────────────────────────────────────────────────────────
# From the MAINNET Developer Portal project, not the Testnet one.
# Every authenticated request validates the caller's token against Pi with
# this key, so a wrong value makes the whole app look signed-out.
PI_API_KEY=

# Where the app answers. Used for absolute URLs in server-side fetches.
# Start with the Vercel deployment URL; change it if you later attach a domain.
NEXT_PUBLIC_APP_URL=https://

# ── Database ──────────────────────────────────────────────────────────────
# A NEW Neon database. Not the testnet one, not a branch of it.
# Run `npx prisma migrate deploy` against it before first use.
DATABASE_URL=

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated Pi usernames. An empty value is treated as unset and falls
# back to douyonevenst54 — set it explicitly anyway, so the fallback is never
# the thing keeping you in.
PPA_ADMIN_USERNAMES=douyonevenst54

# ── Partner keys ──────────────────────────────────────────────────────────
# false means only hashed keys are accepted. A fresh database has no legacy
# plaintext keys to accommodate, so Mainnet starts strict and stays that way.
PPA_ALLOW_PLAINTEXT_KEYS=false

# ── Daily rotation ────────────────────────────────────────────────────────
# Any long random string. Without it /api/cron/daily-challenge stays closed,
# and the day's question set is built by whoever opens the app first.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Supporter tiers (optional) ────────────────────────────────────────────
# Off until PPA is whitelisted for Pi's Staking Data API. Perks are
# recognition and early access only — no PPA, no multiplier, no reputation.
STAKER_PERKS_ENABLED=false
PI_STAKING_API_URL=
PI_STAKING_AUTH=
PI_STAKING_FIELD=

# ── Deliberately absent ───────────────────────────────────────────────────
# Do not carry these over from the testnet environment. Each belonged to
# something that no longer exists, and a credential outliving its feature is
# one nobody is watching:
#
#   ANTHROPIC_API_KEY     the removed question generator
#   ANTHROPIC_MODEL       same
#   WALLET_PRIVATE_SEED   A2U payouts, removed with redemption
#   APP_WALLET_ADDRESS    same
#   LOPIPO_API_SECRET     superseded by hashed partner keys
