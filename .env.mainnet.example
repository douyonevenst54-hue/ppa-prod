# Mainnet environment for Pap Pad App.
#
# Copy to .env.mainnet, fill in, and set the same values in the Vercel project
# that serves Mainnet. Nothing here is shared with the Testnet deployment:
# a testnet API key in a mainnet app makes payments fail, and a shared database
# would carry testnet balances into real play.
#
#   cp .env.mainnet.example .env.mainnet
#   npx tsx --env-file=.env.mainnet scripts/bootstrap-mainnet.ts
#
# Never commit the filled-in file. .env* is gitignored except this example.

# ── The network switch ────────────────────────────────────────────────────
# Flips the app to Mainnet and removes the TEST-PI badge from the balance.
NEXT_PUBLIC_PI_NETWORK=mainnet

# Leave unset or false on Mainnet. Sandbox is a testnet convenience.
NEXT_PUBLIC_PI_SANDBOX=false

# ── Pi ────────────────────────────────────────────────────────────────────
# From the MAINNET Developer Portal project, not the Testnet one.
#
# This authorises SERVER-TO-SERVER calls to Pi: approving and completing
# payments (/api/payments/*, /api/ppa/topup/*) and the staking read. It is
# sent as `Authorization: Key <PI_API_KEY>`.
#
# It is NOT used to sign anyone in. Identity is resolved by sending the
# player's own token to GET api.minepi.com/v2/me as a Bearer token, which
# needs no app key. So a wrong or missing value here breaks PAYMENTS while
# sign-in keeps working — which is the opposite of what it looks like, and
# worth knowing before debugging the wrong half.
#
# Never generate it once and copy it between networks: a testnet key in a
# mainnet app makes payments fail.
PI_API_KEY=

# Where the app answers. Used for absolute URLs in server-side fetches.
# Start with the Vercel deployment URL; change it if you later attach a domain.
NEXT_PUBLIC_APP_URL=https://

# ── Pi Sign-In (web sign-in outside Pi Browser) ───────────────────────────
# The oAuth Client ID from Developer Portal → Pi Sign-In. Public by design:
# the implicit flow issues no client secret, and this value travels in the
# authorize URL, so NEXT_PUBLIC_ is correct rather than careless.
#
# Leave it EMPTY to switch web sign-in off. The app then behaves exactly as
# before — Pi Browser only, no sign-in button for anyone else — rather than
# offering a door that leads nowhere.
#
# Each Developer Portal project has its own client ID. The Mainnet project's
# is not the Testnet one.
#
# Before this works in production you must also:
#   1. verify the domain in the Developer Portal, then
#   2. register https://<that domain>/auth/callback as a Redirect URI.
# Until the domain is verified Pi accepts only loopback URIs, which is what
# local development uses — so the flow is testable today.
NEXT_PUBLIC_PI_CLIENT_ID=

# The origin whose /auth/callback is registered in the portal — the project's
# VERIFIED APP DOMAIN (the URL shown in Developer Portal → App Info).
#
# Set this whenever the app answers on more than one host. PPA does: on
# Testnet, pappad.app and ppa-prod.vercel.app serve the same deployment, but
# Pi accepts a redirect only on the verified one. It said so verbatim when a
# third host was offered:
#
#   "https://pappadappnpn9819.pinet.com/auth/callback" — host must be
#   ppa-prod.vercel.app or a loopback address.
#
# Without this, someone who reaches PPA on any other host presses Sign in and
# Pi rejects the request before they ever see a password field. With it, they
# are sent to the canonical host and sign in there.
#
# Leave it empty for a single-domain deployment; sign-in then starts wherever
# the visitor is, which is correct when there is only one place to be.
NEXT_PUBLIC_PI_SIGNIN_ORIGIN=

# ── Database ──────────────────────────────────────────────────────────────
# A NEW Neon database. Not the testnet one, not a branch of it.
# Run `npx prisma migrate deploy` against it before first use.
DATABASE_URL=

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated Pi usernames. An empty value is treated as unset and falls
# back to douyonevenst54 — set it explicitly anyway, so the fallback is never
# the thing keeping you in.
PPA_ADMIN_USERNAMES=douyonevenst54

# ── Partner keys ──────────────────────────────────────────────────────────
# false means only hashed keys are accepted. A fresh database has no legacy
# plaintext keys to accommodate, so Mainnet starts strict and stays that way.
PPA_ALLOW_PLAINTEXT_KEYS=false

# ── Daily rotation ────────────────────────────────────────────────────────
# Any long random string. Without it /api/cron/daily-challenge stays closed,
# and the day's question set is built by whoever opens the app first.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Supporter tiers (optional) ────────────────────────────────────────────
# Off until PPA is whitelisted for Pi's Staking Data API. Perks are
# recognition and early access only — no PPA, no multiplier, no reputation.
STAKER_PERKS_ENABLED=false
PI_STAKING_API_URL=
PI_STAKING_AUTH=
PI_STAKING_FIELD=

# ── Deliberately absent ───────────────────────────────────────────────────
# Do not carry these over from the testnet environment. Each belonged to
# something that no longer exists, and a credential outliving its feature is
# one nobody is watching:
#
#   ANTHROPIC_API_KEY     the removed question generator
#   ANTHROPIC_MODEL       same
#   WALLET_PRIVATE_SEED   A2U payouts, removed with redemption
#   APP_WALLET_ADDRESS    same
#   LOPIPO_API_SECRET     superseded by hashed partner keys
