// prisma/schema.prisma
//
// Source of truth: the live ppa_production Neon database
// (introspected via `prisma db pull` on 2026-05-22).
//
// Patches applied on top of the introspection:
//   1. @default(cuid()) restored on every model's id (introspection strips
//      these because Postgres just sees text columns).
//   2. Auto-named relations (e.g. `Content Content`) renamed to lowercase
//      conventions that match how application code accesses them
//      (e.g. `content.predictions`, `user.results`).
//   3. Nothing else changed. No new fields, no new tables, no schema
//      changes that aren't already in the DB. Migrations untouched.
//
// If you need to add fields (explanation, source, createdBy, etc.) or
// new tables (AIGenerationLog, AIContentDraft), do so via a proper
// migration in a separate PR. Do not append duplicate model blocks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core user & content
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  piUserId           String   @unique
  username           String   @unique
  ppaBalance         Int      @default(100)
  accuracyRate       Float    @default(0)
  reputationScore    Float    @default(0)
  streakDays         Int      @default(0)
  lastActiveDate     DateTime?
  lastStreakDate     DateTime?
  longestStreak      Int      @default(0)
  tier               UserTier @default(NEWCOMER)
  totalPredictions   Int      @default(0)
  correctPredictions Int      @default(0)
  totalChallenges    Int      @default(0)
  correctChallenges  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  emblem             Emblem?

  // --- compliance additions (2026-08) ------------------------------------
  /// When the user confirmed they meet the minimum age. Null = never asked.
  /// We store the confirmation, not a date of birth: a stored DOB is a
  /// liability with no product use.
  ageAttestedAt      DateTime?
  ageAttestedMin     Int?

  /// User has removed themselves from all public leaderboards.
  leaderboardOptOut  Boolean   @default(false)

  /// Soft delete. Identifiers are scrubbed at the same time.
  /// EVERY public query must filter on `deletedAt: null`.
  deletedAt          DateTime?

  results             ChallengeResult[]
  createdContent      Content[]
  transactions        PPATransaction[]
  pollVotes           PollVote[]
  predictions         Prediction[]
  topUps              TopUp[]
  redemptionAttempts  RedemptionAttempt[]

  @@index([deletedAt, leaderboardOptOut])
  @@index([totalPredictions])
  @@index([reputationScore])
}

model Content {
  id               String        @id @default(cuid())
  creatorId        String
  title            String
  category         Category
  status           ContentStatus @default(PENDING)
  type             String
  endsAt           DateTime
  rewardPool       Int           @default(0)
  participantCount Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator     User         @relation(fields: [creatorId], references: [id])
  pollOptions PollOption[]
  predictions Prediction[]
  questions   Question[]
  outcome     String?
  settledAt   DateTime?
}

model Question {
  id            String     @id @default(cuid())
  contentId     String?
  text          String
  options       Json
  correctAnswer String
  category      Category
  difficulty    Difficulty
  qualityScore  Int        @default(0)
  timesServed   Int        @default(0)
  timesCorrect  Int        @default(0)
  createdAt     DateTime   @default(now())

  content Content?          @relation(fields: [contentId], references: [id])
  results ChallengeResult[]
}

model ChallengeResult {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  isCorrect   Boolean
  timeSeconds Int
  ppaEarned   Int      @default(0)
  streakBonus Int      @default(0)
  createdAt   DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model Prediction {
  id              String   @id @default(cuid())
  userId          String
  contentId       String
  answer          String
  confidenceLevel Int
  stakeAmount     Int
  potentialReward Int
  isCorrect       Boolean?
  ppaEarned       Int      @default(0)
  createdAt       DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  @@unique([userId, contentId])
}

model PollOption {
  id        String   @id @default(cuid())
  contentId String
  text      String
  voteCount Int      @default(0)
  createdAt DateTime @default(now())

  content Content    @relation(fields: [contentId], references: [id])
  votes   PollVote[]
}

model PollVote {
  id           String   @id @default(cuid())
  userId       String
  pollOptionId String
  ppaWeight    Int      @default(0)
  createdAt    DateTime @default(now())

  pollOption PollOption @relation(fields: [pollOptionId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([userId, pollOptionId])
}

model PPATransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  type           String
  source         String
  createdAt      DateTime @default(now())
  balanceAfter   Int?
  prevHash       String?
  rowHash        String?  @unique
  idempotencyKey String?  @unique
  isSnapshot     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isSnapshot])
  /// Note: the award gate reads the chain tail on every write with
  /// ORDER BY createdAt DESC within a user. The existing [userId, createdAt]
  /// btree already serves that (Postgres scans btrees backwards), so no
  /// additional index is needed here.
}

// ---------------------------------------------------------------------------
// PPA Ecosystem Registry
// ---------------------------------------------------------------------------

model PPAApp {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  url         String
  logoUrl     String?
  apiKey      String    @unique
  apiKeyHash  String?   @unique
  status      AppStatus @default(ACTIVE)
  category    String    @default("GENERAL")
  totalEarned Int       @default(0)
  totalSpent  Int       @default(0)
  userCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Maximum PPA this partner app may mint per UTC day. Null = platform default.
  /// A leaked partner key can burn one day of one app's budget, and no more.
  dailyEmissionCap Int?

  mandates       AgentMandate[]
  transactions   EcosystemTransaction[]
  dailyEmissions AppDailyEmission[]
}

model EcosystemTransaction {
  id        String   @id @default(cuid())
  appId     String
  piUserId  String
  username  String
  amount    Int
  type      String
  source    String
  createdAt DateTime @default(now())

  app PPAApp @relation(fields: [appId], references: [id])
}

// ---------------------------------------------------------------------------
// Agent mandate system
// ---------------------------------------------------------------------------

model AgentMandate {
  id            String        @id @default(cuid())
  piUserId      String
  agentId       String
  appId         String
  scope         Json
  cap           Int
  spent         Int           @default(0)
  perTxCap      Int?
  rateLimit     Json?
  notBefore     DateTime
  expiresAt     DateTime
  status        MandateStatus @default(ACTIVE)
  signature     String
  signingKeyId  String
  nonceSalt     String
  issuedAt      DateTime      @default(now())
  revokedAt     DateTime?
  revokedReason String?

  app        PPAApp         @relation(fields: [appId], references: [id])
  signingKey UserSigningKey @relation(fields: [signingKeyId], references: [id])
  audits     AgentAudit[]
  nonces     MandateNonce[]

  @@index([appId, status])
  @@index([expiresAt])
  @@index([piUserId, status])
}

model AgentAudit {
  id        String          @id @default(cuid())
  mandateId String?
  piUserId  String
  agentId   String
  appId     String
  eventType AgentAuditEvent
  payload   Json
  prevHash  String
  rowHash   String          @unique
  createdAt DateTime        @default(now())

  mandate AgentMandate? @relation(fields: [mandateId], references: [id])

  @@index([mandateId])
  @@index([piUserId, createdAt])
}

model MandateNonce {
  id          String    @id @default(cuid())
  mandateId   String
  nonce       String    @unique
  actionHash  String
  amount      Int
  consumed    Boolean   @default(false)
  consumedAt  DateTime?
  piPaymentId String?
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime

  mandate AgentMandate @relation(fields: [mandateId], references: [id])

  @@index([expiresAt])
  @@index([mandateId, consumed])
}

model UserSigningKey {
  id        String    @id @default(cuid())
  piUserId  String
  publicKey String
  label     String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  mandates AgentMandate[]

  @@index([piUserId])
  @@index([piUserId, revokedAt])
}

// ---------------------------------------------------------------------------
// Compliance: top-ups, emission control, audit  (added 2026-08)
// ---------------------------------------------------------------------------

enum TopUpStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
}

/// One row per Pi payment used to buy PPA.
///
/// `piPaymentId` is unique, and that uniqueness is the anti-double-credit
/// mechanism: approve() upserts on it, creditTopUp() keys its idempotency on it.
model TopUp {
  id          String      @id @default(cuid())
  piPaymentId String      @unique
  piTxid      String?
  userId      String
  amountPi    Decimal     @db.Decimal(18, 8)
  ppaAmount   Int
  status      TopUpStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

/// Per-user, per-source emission counter for one UTC day.
///
/// Read and incremented inside the award() transaction. The compound unique is
/// what makes the upsert atomic under concurrency.
model UserDailyEmission {
  id       String   @id @default(cuid())
  piUserId String
  day      DateTime @db.Date
  source   String
  emitted  Int      @default(0)

  @@unique([piUserId, day, source])
  @@index([day])
}

/// Per-app, per-day emission counter. The partner budget.
///
/// Checked and reserved before a partner credit mints anything, so two
/// concurrent calls from the same app can't both pass the ceiling.
model AppDailyEmission {
  id      String   @id @default(cuid())
  appId   String
  day     DateTime @db.Date
  emitted Int      @default(0)

  app PPAApp @relation(fields: [appId], references: [id])

  @@unique([appId, day])
  @@index([day])
}


/// Global emission counter for one UTC day. The circuit breaker.
///
/// If an exploit gets past the per-user caps, the platform stops minting for the
/// day rather than inflating the supply overnight.
model DailyEmission {
  day       DateTime @id @db.Date
  emitted   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Audit trail for calls to the disabled redemption endpoint.
///
/// Exists so that if anyone ever asks "did redemption run after the cutover?",
/// there is a table that answers no.
model RedemptionAttempt {
  id          String   @id @default(cuid())
  userId      String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([attemptedAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AgentAuditEvent {
  MANDATE_ISSUED
  MANDATE_REVOKED
  NONCE_ISSUED
  PAYMENT_VERIFIED
  PAYMENT_SETTLED
  PAYMENT_REJECTED
  CAP_HIT
  RATE_LIMIT_HIT
}

enum AppStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Category {
  SPORTS
  FINANCE
  TECH
  POLITICS
  SOCIAL
  GENERAL
}

enum ContentStatus {
  PENDING
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MandateStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum UserTier {
  NEWCOMER
  MEMBER
  TRUSTED
  EXPERT
  ELITE
}

enum Realm {
  THINK
  PREDICT
  CREATE
  COMPETE
  EXPLORE
  CONNECT
  LEAD
}

/// One Emblem per user. A view of their record, recomputed from counters.
///
/// Every field here is derivable — the row is a cache, not a source of truth.
/// Delete the whole table and it regenerates identically, which is the property
/// that keeps an Emblem from ever becoming a broken image.
model Emblem {
  id           String   @id @default(cuid())
  userId       String   @unique
  primaryRealm Realm
  /// Sum of the seven realm levels, 0-35.
  level        Int      @default(0)
  /// Frozen once computed — "first 1,000 accounts" must keep meaning that.
  pioneer      Boolean  @default(false)
  /// { THINK: 3, PREDICT: 1, ... }
  realmLevels  Json
  /// Raw scores behind those levels, for display and for debugging retunes.
  realmScores  Json
  /// Derived visual traits. Cached so the renderer doesn't recompute per request.
  traits       Json

  /// --- reserved, unused ---
  transferable Boolean   @default(false)
  tokenId      String?   @unique
  mintedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  milestones EmblemMilestone[]

  @@index([primaryRealm, level])
  @@index([level])
}

/// A threshold crossed, recorded permanently.
///
/// Levels are recomputed from live counters, but milestones are append-only.
/// If the scoring formula is ever retuned, the history of what someone actually
/// achieved under the old rules survives — which is the difference between a
/// record and a leaderboard.
model EmblemMilestone {
  id         String   @id @default(cuid())
  emblemId   String
  realm      Realm
  level      Int
  achievedAt DateTime @default(now())

  emblem Emblem @relation(fields: [emblemId], references: [id], onDelete: Cascade)

  @@unique([emblemId, realm, level])
  @@index([achievedAt])
}
