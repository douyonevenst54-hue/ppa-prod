// ============================================================================
// PPA compliance migration — additions only.
//
// Merge these into your existing schema.prisma, then:
//
//   npx prisma migrate dev --name compliance_topup_agegate_privacy
//
// Never `prisma db push`.
//
// Nothing here is destructive. The old redemption models (if you have any) can
// stay in place — the route that used them is a 410 now, so they'll simply stop
// receiving writes. Drop them in a separate migration once you're confident.
// ============================================================================

// --- Add these fields to your existing User model --------------------------
//
// model User {
//   emblem Emblem?
//   ...existing fields...
//
//   /// When the user confirmed they meet the minimum age. Null = never asked.
//   /// We store the confirmation, not a date of birth.
//   ageAttestedAt      DateTime?
//   ageAttestedMin     Int?
//
//   /// User has removed themselves from all public leaderboards.
//   leaderboardOptOut  Boolean   @default(false)
//
//   /// Soft delete. Set on self-service deletion; identifiers are scrubbed at
//   /// the same time. Every public query must filter on `deletedAt: null`.
//   deletedAt          DateTime?
//
//   /// Resolved/correct counts, denormalised so the leaderboard can rank on
//   /// them without a join. Keep them updated in the same transaction that
//   /// resolves a prediction.
//   predictionsResolved Int @default(0)
//   predictionsCorrect  Int @default(0)
//
//   topUps             TopUp[]
//   redemptionAttempts RedemptionAttempt[]
//
//   @@index([deletedAt, leaderboardOptOut])
//   @@index([predictionsResolved])
// }

enum TopUpStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
}

/// One row per Pi payment used to buy PPA.
///
/// `piPaymentId` is unique, and that uniqueness is the whole anti-double-credit
/// mechanism: approve upserts on it, complete reads it inside the transaction
/// and refuses to credit twice. This is the fix for stuck/replayed payments.
model TopUp {
  id           String      @id @default(cuid())
  piPaymentId  String      @unique
  piTxid       String?
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  amountPi     Decimal     @db.Decimal(18, 8)
  ppaAmount    Int
  status       TopUpStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

/// Audit trail for calls to the disabled redemption endpoint.
///
/// Exists so that if anyone ever asks "did redemption run after the cutover?",
/// there is a table that answers no. Rows should be rare after old clients age out.
model RedemptionAttempt {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userAgent  String?
  attemptedAt DateTime @default(now())

  @@index([attemptedAt])
}

// Emblem additions. Merge into prisma/schema.prisma, then:
//   npx prisma migrate dev --name emblems
//
// Additive only. Nothing existing is changed or dropped.
//
// NOTE ON tokenId / mintedAt / transferable:
//   These columns exist but are unused. They are the ONLY difference between
//   the soulbound system shipping now and an on-chain version later. Keeping
//   them in the schema from day one means the later decision is a migration of
//   behaviour, not a rewrite of the model — and keeping them NULL and false
//   means nothing is transferable until someone deliberately changes that.
// ============================================================================

enum Realm {
  THINK
  PREDICT
  CREATE
  COMPETE
  EXPLORE
  CONNECT
  LEAD
}

/// One Emblem per user. A view of their record, recomputed from counters.
///
/// Every field here is derivable — the row is a cache, not a source of truth.
/// Delete the whole table and it regenerates identically, which is the property
/// that keeps an Emblem from ever becoming a broken image.
model Emblem {
  id           String   @id @default(cuid())
  userId       String   @unique
  primaryRealm Realm
  /// Sum of the seven realm levels, 0-35.
  level        Int      @default(0)
  /// Frozen once computed — "first 1,000 accounts" must keep meaning that.
  pioneer      Boolean  @default(false)
  /// { THINK: 3, PREDICT: 1, ... }
  realmLevels  Json
  /// Raw scores behind those levels, for display and for debugging retunes.
  realmScores  Json
  /// Derived visual traits. Cached so the renderer doesn't recompute per request.
  traits       Json

  /// --- reserved, unused ---
  transferable Boolean   @default(false)
  tokenId      String?   @unique
  mintedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  milestones EmblemMilestone[]

  @@index([primaryRealm, level])
  @@index([level])
}

/// A threshold crossed, recorded permanently.
///
/// Levels are recomputed from live counters, but milestones are append-only.
/// If the scoring formula is ever retuned, the history of what someone actually
/// achieved under the old rules survives — which is the difference between a
/// record and a leaderboard.
model EmblemMilestone {
  id         String   @id @default(cuid())
  emblemId   String
  realm      Realm
  level      Int
  achievedAt DateTime @default(now())

  emblem Emblem @relation(fields: [emblemId], references: [id], onDelete: Cascade)

  @@unique([emblemId, realm, level])
  @@index([achievedAt])
}
