enum TopUpStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
}

/// One row per Pi payment used to buy PPA.
///
/// `piPaymentId` is unique, and that uniqueness is the whole anti-double-credit
/// mechanism: approve upserts on it, complete reads it inside the transaction
/// and refuses to credit twice. This is the fix for stuck/replayed payments.
model TopUp {
  id           String      @id @default(cuid())
  piPaymentId  String      @unique
  piTxid       String?
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  amountPi     Decimal     @db.Decimal(18, 8)
  ppaAmount    Int
  status       TopUpStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

/// Audit trail for calls to the disabled redemption endpoint.
///
/// Exists so that if anyone ever asks "did redemption run after the cutover?",
/// there is a table that answers no. Rows should be rare after old clients age out.
model RedemptionAttempt {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userAgent  String?
  attemptedAt DateTime @default(now())

  @@index([attemptedAt])
}
